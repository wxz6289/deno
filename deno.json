{
  "nodeModulesDir": "auto",
  "importMap": "./import_map.json",
  "dependencies": {
    "@scope/add": "./add/mod.ts",
    "@scope/log": "./log/index.ts",
    "@std/assert": "jsr:@std/assert@1"
  },
  "workspace": [
    "./add",
    "./test",
    "./log",
    "./learn",
    "./bundle",
    "./fs",
    "./npm",
    "./http",
    "./fresh",
    "./deno-fresh",
    "./ffi/n-api"
  ],
  "tasks": {
    "dev": "deno run --watch main.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@scope/add": "./add/mod.ts",
    "@scope/log": "./log/index.ts",
    "chalk": "npm:chalk@^5.6.2",
    "react": "npm:react@^19.2.0",
    "react-dom": "npm:react-dom@^19.2.0"
  },
  "compilerOptions": {
    "types": [
      "jsr:@std/assert@1"
    ],
    "paths": {
      "@scope/add": ["./add/mod.ts"],
      "@scope/log": ["./log/index.ts"]
    }
  }
}
